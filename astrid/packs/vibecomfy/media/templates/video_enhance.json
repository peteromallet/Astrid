{
  "schema_version": 1,
  "template_id": "video/video_enhance_direct",
  "capability_id": "vibecomfy.video_enhance",
  "model_identity": "video-enhance.upscale-2x",
  "engine": "vibecomfy",
  "output_kind": "video",
  "bindings": {
    "video_ref": {"node": "input", "field": "video"},
    "scale": {"node": "scale", "field": "scale_by"},
    "upscale_method": {"node": "scale", "field": "upscale_method"},
    "enable_interpolation": {"node": "output", "field": "enable_interpolation"},
    "enable_upscale": {"node": "output", "field": "enable_upscale"},
    "preserve_audio": {"node": "output", "field": "preserve_audio"},
    "preserve_source_fps": {"node": "output", "field": "preserve_source_fps"}
  },
  "workflow": {
    "nodes": {
      "input": {"class_type": "VHS_LoadVideo", "inputs": {"video": ""}},
      "scale": {"class_type": "ImageScaleBy", "inputs": {"image": ["input", 0], "scale_by": 2.0, "upscale_method": "lanczos"}},
      "output": {"class_type": "VHS_VideoCombine", "inputs": {"images": ["scale", 0], "audio": ["input", 2], "enable_interpolation": false, "enable_upscale": true, "preserve_audio": true, "preserve_source_fps": true, "filename_prefix": "video-enhance"}}
    }
  }
}
