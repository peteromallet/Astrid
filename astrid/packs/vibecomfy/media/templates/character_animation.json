{
  "schema_version": 1,
  "template_id": "video/wan22_character_animation_direct",
  "capability_id": "vibecomfy.character_animation",
  "model_identity": "wan-2.2-animate-14b",
  "engine": "vibecomfy",
  "output_kind": "video",
  "bindings": {
    "reference_image_ref": {"node": "reference", "field": "image"},
    "driving_video_ref": {"node": "driving", "field": "video"},
    "prompt": {"node": "text", "field": "prompt"},
    "negative_prompt": {"node": "text", "field": "negative_prompt"},
    "seed": {"node": "sampler", "field": "seed"},
    "width": {"node": "latent", "field": "width"},
    "height": {"node": "latent", "field": "height"},
    "frames": {"node": "latent", "field": "frames"},
    "fps": {"node": "output", "field": "fps"},
    "steps": {"node": "sampler", "field": "steps"}
  },
  "workflow": {
    "nodes": {
      "reference": {"class_type": "LoadImage", "inputs": {"image": ""}},
      "driving": {"class_type": "VHS_LoadVideo", "inputs": {"video": ""}},
      "text": {"class_type": "WanTextEncode", "inputs": {"prompt": "", "negative_prompt": ""}},
      "latent": {"class_type": "WanAnimateLatent", "inputs": {"width": 832, "height": 480, "frames": 81, "reference": ["reference", 0], "driving": ["driving", 0]}},
      "sampler": {"class_type": "WanAnimateSampler", "inputs": {"seed": 42, "steps": 6}},
      "decode": {"class_type": "WanDecode", "inputs": {"samples": ["sampler", 0]}},
      "output": {"class_type": "VHS_VideoCombine", "inputs": {"images": ["decode", 0], "fps": 16, "filename_prefix": "wan22-character-animation"}}
    }
  }
}
