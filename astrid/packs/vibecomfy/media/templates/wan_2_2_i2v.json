{
  "schema_version": 1,
  "template_id": "video/wan22_i2v_direct",
  "capability_id": "vibecomfy.wan_2_2_i2v",
  "model_identity": "wan-2.2-a14b-i2v",
  "engine": "vibecomfy",
  "output_kind": "video",
  "bindings": {
    "image_ref": {"node": "image", "field": "image"},
    "prompt": {"node": "text", "field": "prompt"},
    "negative_prompt": {"node": "text", "field": "negative_prompt"},
    "seed": {"node": "sampler", "field": "seed"},
    "width": {"node": "latent", "field": "width"},
    "height": {"node": "latent", "field": "height"},
    "frames": {"node": "latent", "field": "frames"},
    "fps": {"node": "output", "field": "fps"},
    "steps": {"node": "sampler", "field": "steps"},
    "guidance_scale": {"node": "sampler", "field": "guidance_scale"}
  },
  "workflow": {
    "nodes": {
      "image": {"class_type": "LoadImage", "inputs": {"image": ""}},
      "text": {"class_type": "WanTextEncode", "inputs": {"prompt": "", "negative_prompt": ""}},
      "latent": {"class_type": "WanImageToVideoLatent", "inputs": {"width": 832, "height": 480, "frames": 81, "image": ["image", 0]}},
      "sampler": {"class_type": "WanSampler", "inputs": {"seed": 0, "steps": 6, "guidance_scale": 1.0}},
      "decode": {"class_type": "WanDecode", "inputs": {"samples": ["sampler", 0]}},
      "output": {"class_type": "VHS_VideoCombine", "inputs": {"images": ["decode", 0], "fps": 16, "filename_prefix": "wan-2-2-i2v"}}
    }
  }
}
