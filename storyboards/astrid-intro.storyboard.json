        "active": 0
      },
      "image": {
        "variants": [
          {
            "source": "asset",
            "path": "../projects/astrid-intro/build/new-slides/idea1_os.png",
            "label": "reused-slide"
          }
        ],
        "active_index": 0
      },
      "vo": {
        "text": "Second, the community knowledge. Astrid doesn't just give your agent tools - it helps it understand how to really use them.",
        "audio": {
          "asset": "../projects/astrid-intro/build/vo/idea1_os.mp3"
        }
      },
      "provenance": {
        "generator": {
          "tool": "edge-tts"
        }
      }
    },
